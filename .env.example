# Environment Configuration for Real-Time Phishing Detection & Prevention Platform

# Server Port & Active Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phishshield_db
DB_USER=phishshield_user
DB_PASSWORD=phishshield_secure_password_2026

# JWT Secret & Expiration (Must be at least 256-bit / 32 characters for HS256/HS512)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Python ML Microservice Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://*

# SSRF Protection Settings
SSRF_PROTECTION_ENABLED=true
SSRF_ALLOW_PRIVATE_IPS=false
