# =============================================================================
# Prahar Security Platform — Environment Variables Example
# Duplicate this file as '.env' and fill in real secrets for production.
# NEVER commit or share the actual '.env' file.
# =============================================================================

# Deployment Environment Profile (dev | mysql | prod)
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=phishshield_db
DB_USER=phishshield_user
DB_PASSWORD=replace_with_strong_database_password_32char_min
DB_ROOT_PASSWORD=replace_with_strong_root_password_32char_min

# JSON Web Token (JWT) Configuration
# MUST be a 256-bit (32+ character) cryptographically random key
JWT_SECRET=replace_with_at_least_256_bit_random_hex_string_key_here
JWT_EXPIRATION_MS=86400000

# Python FastAPI Machine Learning Microservice
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT_MS=3000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,chrome-extension://*

# SSRF Protection & Scanner Security Limits
SSRF_PROTECTION_ENABLED=true
SSRF_ALLOW_PRIVATE_IPS=false

# File Upload & Image Analysis Security Limits
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_WIDTH=4096
UPLOAD_MAX_HEIGHT=4096
UPLOAD_MAX_PIXELS=16777216
UPLOAD_ALLOWED_FORMATS=PNG,JPEG,JPG,WEBP,GIF,BMP

# Prahar AI Chatbot & Google Gemini Provider Settings
# Options: none | gemini | openai | anthropic
AI_PROVIDER=none
AI_API_KEY=your_google_gemini_api_key_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000

# Threat Intelligence Providers (Optional)
THREAT_INTEL_ENABLED=false
THREAT_INTEL_PROVIDER=google
THREAT_INTEL_GOOGLE_KEY=your_google_safebrowsing_api_key_here
THREAT_INTEL_VT_KEY=your_virustotal_api_key_here
THREAT_INTEL_TIMEOUT_MS=3000
THREAT_INTEL_REQUIRE_CONSENT=true

# Notification Dispatch Channels (Optional)
NOTIFICATIONS_EMAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=584
SPRING_MAIL_USERNAME=your_smtp_username
SPRING_MAIL_PASSWORD=your_smtp_app_password

# Frontend Production Settings (Vite / Nginx)
VITE_API_URL=/api
